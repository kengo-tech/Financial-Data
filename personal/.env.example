# Copy to `.env` and fill in. Most sources are KEYLESS; keys below are optional.

# GIE — EU gas storage (AGSI+) & LNG (ALSI). Free instant key:
#   https://agsi.gie.eu/account  (same key works for alsi.gie.eu)
# Required ONLY for the Germany-storage and Spain-LNG frames.
GIE_API_KEY=

# EIA — US weekly working gas. Optional: pipeline falls back to keyless dnav xls.
#   https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# FRED — optional; macro is fetched keyless via fredgraph.csv.
#   https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
